# Maintainer: Rafał Brzegowy <rafal.brzegowy@yahoo.com>

_realname=pyprecice
_realname2=python-bindings
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=3.3.1
pkgrel=1
pkgdesc='Python language bindings for preCICE (mingw-w64)'
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64')
url='https://www.precice.org'
msys2_repository_url='https://github.com/precice/python-bindings'
msys2_references=(
  'aur: pyprecice'
)
license=('spdx:LGPL-3.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-precice"
         "${MINGW_PACKAGE_PREFIX}-python-mpi4py"
         "${MINGW_PACKAGE_PREFIX}-python-cloudpickle"
         "${MINGW_PACKAGE_PREFIX}-python-numpy"
         "${MINGW_PACKAGE_PREFIX}-python-matplotlib")
makedepends=("${MINGW_PACKAGE_PREFIX}-python-pkgconfig"
             "${MINGW_PACKAGE_PREFIX}-python-build"
	         "${MINGW_PACKAGE_PREFIX}-cython"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-setuptools"
			 "${MINGW_PACKAGE_PREFIX}-python-wheel")
source=("https://github.com/precice/python-bindings/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('7ac05da395cab9549a6c87a858cd4bc4776ca55190bc37007c10e5814d22fc57')

build() {
  cp -r "${_realname2}-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"

  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "${srcdir}/python-build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl
}
